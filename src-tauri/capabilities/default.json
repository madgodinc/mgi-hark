{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window and caption overlay: events, window controls for the custom title bar and overlay edit mode.",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "updater:default",
    "process:allow-restart"
  ]
}