{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hark",
  "version": "0.1.9",
  "identifier": "net.mgi.hark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' data: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "Субтитры голосового чата для тех, кто не слышит",
    "publisher": "MGI",
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 MGI. Все права защищены.",
    "licenseFile": "../LICENSE-RU.txt"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzOURCODg4NzYzRTJFRUYKUldUdkxqNTJpTGlkSTFLbnJsdkpXVVh0VzJCUTl0anZsMjNPOGFrMjE0WnVUMDhmSUlDS3Z1T24K",
      "endpoints": [
        "https://madgodinc.net/hark/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
